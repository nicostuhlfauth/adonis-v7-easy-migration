{
  "name": "adonis-v7-easy-migration",
  "version": "1.0.0",
  "description": "Automated migration tool for AdonisJS v6 → v7",
  "type": "module",
  "bin": {
    "adonis-v7-migrate": "./build/bin/run.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --import tsx --test 'tests/**/*.spec.ts'",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "execa": "^9.6.1",
    "globby": "^16.1.1",
    "jscodeshift": "^17.3.0",
    "ts-morph": "^27.0.2"
  },
  "devDependencies": {
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^25.3.2",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
